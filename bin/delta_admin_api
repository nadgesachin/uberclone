#!/usr/bin/env node

const cluster = require('cluster');
const os = require("os");
require("dotenv").config();

const numCPUs = os.cpus().length;
const forkCount = process.env.ENV === "development" ? 1 : Math.max(1, numCPUs - 1);

// if (cluster.isMaster) {
//     console.log(`Master ${process.pid} running. Forks: ${forkCount}`);

//     for (let i = 0; i < forkCount; i++) {
//         cluster.fork();
//     }

//     cluster.on("exit", (worker) => {
//         console.log(`Worker ${worker.process.pid} died. Restarting...`);
//         // cluster.fork();
//     });

// } else {

const app = require("../app");
const { setupSocket } = require("../routes/services/socket");
const kafkaConsumer = require("../routes/services/kafka-consumer");
const rideRequestConsumer = require("../routes/services/ride-request-consumer");
const rideAcceptConsumer = require("../routes/services/ride-accept-consumer");
const http = require("http");
const server = http.createServer(app);

const PORT = process.env.PORT || 4000;
// 1. Server पहले start करो (तुरंत listen होना चाहिए)
server.listen(PORT, "0.0.0.0", () => {
  console.log(`Server running on http://localhost:${PORT} | PID: ${process.pid}`);
});

// 2. Server start होने के बाद ही Socket.IO setup करो
setupSocket(server)
  .then(() => {
    console.log("Socket.IO Ready");

    // 3. Socket ready होने के बाद ही Consumer start करो
    rideRequestConsumer();
    rideAcceptConsumer();
    console.log("Ride Request Consumer Started → Topic: ride-request");
  })
  .catch((err) => {
    console.error("Failed to setup Socket.IO:", err);
    process.exit(1);
  });
// }
