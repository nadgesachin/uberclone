# Environment
ENV=development

# Server Configuration
PORT=4000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/uberclone

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BROKER=10.111.80.166:9092

# JWT Secret
JWT_SECRET=SUPERSECRET123

# Encryption Key for Passwords
ENCRYPTION_KEY=MY_SECRET_KEY

# SSH Configuration (Optional - for remote DB access)
SSH_PVT_KEY=
SSH_PASSPHRASE=
SSH_HOST=
SSH_USERNAME=
SSH_DST_HOST=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Database Connection (Sequelize - PostgreSQL)
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE=testdb
DB_HOST=127.0.0.1
DB_DIALECT=postgres

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Message Service (MSG91)
MSG91_AUTHKEY=
MSG91_SENDERID=UBERCLONE

# Payment Gateway (Optional)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=